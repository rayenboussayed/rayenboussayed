{
  "name": "rayenboussayed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "check:assets": "node scripts/check-assets.mjs",
    "prebuild": "node scripts/prepare-bergamot.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "docker:dev": "docker build -f Dockerfile.dev -t rayenboussayed-dev . && docker run -d --name rayenboussayed-dev -p 5173:5173 -v .:/app -v /app/node_modules -e CHOKIDAR_USEPOLLING=true -it rayenboussayed-dev",
    "docker:logs": "docker logs -f rayenboussayed-dev",
    "docker:down": "docker stop rayenboussayed-dev",
    "knip": "knip",
    "prepare": "husky",
    "predev": "node scripts/prepare-bergamot.mjs"
  },
  "dependencies": {
    "@astryxdesign/cli": "0.7.14",
    "@astryxdesign/core": "0.7.14",
    "@astryxdesign/theme-butter": "0.7.14",
    "@astryxdesign/theme-neutral": "0.7.14",
    "@astryxdesign/theme-y2k": "0.7.14",
    "@mkljczk/bergamot-translator": "^0.4.16",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@stylexjs/stylex": "^0.19.2",
    "@stylexjs/unplugin": "^0.19.2",
    "comlink": "^4.4.2",
    "idb": "^8.0.4",
    "motion": "^14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "knip": "^6.45.1",
    "oxlint": "^1.93.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "browserslist": [
    "last 1 Chrome version"
  ]
}
